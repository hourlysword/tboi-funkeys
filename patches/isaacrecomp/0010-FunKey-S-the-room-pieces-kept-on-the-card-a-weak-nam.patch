+
+#if defined(ISAAC_FUNKEY)
+// ------------------------------------------------------------ the pieces kept on the card (FunKey)
+// A room's floor and walls are drawn into its bitmap from 50-110 pieces, shapes with up to thousands of edges; the
+// first time a piece is seen it is parsed and rasterized, 1-3 ms each on the console: most of a room entry. So the
+// pieces rasterized are also written to saves/leaves_<SWF length>.data (zlib), each listed in .index (read at start),
+// and a piece drawn in an earlier room or session is read back from there instead. Its key holds no pointer: the
+// character's id and kind, the morph ratio, the matrix, the colour transform and the sub-pixel offset (dynamic text,
+// which changes, is left out). Both files are for one build of the program and one game file (in their header;
+// otherwise they start afresh), and only without mods (some change shapes). Up to 16 MB; a piece read back is checked
+// (key, CRC) and dropped if it doesn't match.
+namespace {
+struct DiskKey { uint16_t charId; uint8_t kind, pad; uint32_t variant; float a, b, c, d; float cx[8]; uint32_t fxy; };
+struct DiskHead { DiskKey key; uint16_t w, h; uint32_t len, crc; };   // in .data, before each piece's compressed pixels
+struct DiskFileHead { char magic[8]; uint32_t version, sub; uint8_t build[20]; uint32_t swfLen, which; };
+struct DiskSlot { uint64_t hash; uint32_t off, len; };                 // an entry of .index (hash 0: an empty slot)
+struct DiskQueued { DiskKey k; LeafRaster r; };   // a piece rasterized, to be written in idle time
+struct LeafDisk {
+    bool on = false, pending = false;
+    FILE* dataW = nullptr; FILE* indexW = nullptr; int dataR = -1;
+    uint64_t dataSize = 0; uint64_t maxBytes = 16u << 20;
+    std::vector<DiskSlot> tab; size_t count = 0;
+    std::vector<DiskQueued> queue; size_t queueBytes = 0, queueMax = 512u << 10;
+    uint64_t hits = 0, stored = 0, bad = 0, readBytes = 0, writeBytes = 0; double readMs = 0, writeMs = 0;
+} g_ld;
+uint64_t diskHash(const DiskKey& k) {
+    const uint8_t* p = (const uint8_t*)&k; uint64_t h = 1469598103934665603ull;
+    for (size_t i = 0; i < sizeof k; i++) { h ^= p[i]; h *= 1099511628211ull; }
+    return h ? h : 1;
+}
+DiskSlot* diskFind(uint64_t h) {
+    if (g_ld.tab.empty()) return nullptr;
+    size_t mask = g_ld.tab.size() - 1;
+    for (size_t i = h & mask;; i = (i + 1) & mask) { if (g_ld.tab[i].hash == h) return &g_ld.tab[i]; if (!g_ld.tab[i].hash) return nullptr; }
+}
+void diskInsert(const DiskSlot& e) {
+    if ((g_ld.count + 1) * 10 > g_ld.tab.size() * 7) {   // (load factor 0.7)
+        std::vector<DiskSlot> old; old.swap(g_ld.tab);
+        g_ld.tab.assign(std::max<size_t>(4096, old.size() * 2), DiskSlot{0, 0, 0}); g_ld.count = 0;
+        for (auto& o : old) if (o.hash) diskInsert(o);
+    }
+    size_t mask = g_ld.tab.size() - 1;
+    for (size_t i = e.hash & mask;; i = (i + 1) & mask) {
+        if (g_ld.tab[i].hash == e.hash) { g_ld.tab[i] = e; return; }
+        if (!g_ld.tab[i].hash) { g_ld.tab[i] = e; g_ld.count++; return; }
+    }
+}
+bool diskKeyOf(const LeafPlan& p, DiskKey& k) {
+    if (p.d->kind != OK_SHAPE && p.d->kind != OK_MORPH && p.d->kind != OK_TEXT) return false;
+    if ((const void*)g_movie.get(p.d->charId) != p.key.def) return false;   // (only the game file's own characters)
+    memset(&k, 0, sizeof k);
+    k.charId = p.d->charId; k.kind = (uint8_t)p.d->kind; k.variant = p.key.variant;
+    k.a = p.key.a; k.b = p.key.b; k.c = p.key.c; k.d = p.key.d; memcpy(k.cx, p.key.cx, sizeof k.cx); k.fxy = p.key.fxy;
+    return true;
+}
+// a piece listed in the index into r (its size checked by the caller); false if absent or not as written
+bool diskRead(const DiskKey& k, const DiskSlot& e, LeafRaster& r) {
+    auto t0 = std::chrono::steady_clock::now();
+    std::vector<uint8_t> buf(sizeof(DiskHead) + e.len);
+    bool ok = pread(g_ld.dataR, buf.data(), buf.size(), (off_t)e.off) == (ssize_t)buf.size();
+    DiskHead h; if (ok) memcpy(&h, buf.data(), sizeof h);
+    ok = ok && !memcmp(&h.key, &k, sizeof k) && h.len == e.len && h.w && h.h &&
+         (uint32_t)crc32(0, buf.data() + sizeof h, e.len) == h.crc;
+    if (ok) {
+        r.px.resize((size_t)h.w * h.h); uLongf n = (uLongf)(r.px.size() * 4);
+        ok = uncompress((Bytef*)r.px.data(), &n, buf.data() + sizeof h, e.len) == Z_OK && n == r.px.size() * 4;
+        r.w = h.w; r.h = h.h;
+    }
+    g_ld.readMs += std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+    g_ld.readBytes += buf.size();
+    return ok;
+}
+void diskWrite(const DiskKey& k, const LeafRaster& r) {
+    if (r.w <= 0 || r.h <= 0 || r.w > 65535 || r.h > 65535) return;
+    auto t0 = std::chrono::steady_clock::now();
+    uLongf n = compressBound((uLong)(r.px.size() * 4));
+    std::vector<uint8_t> z(n);
+    if (compress2(z.data(), &n, (const Bytef*)r.px.data(), (uLong)(r.px.size() * 4), 1) != Z_OK) return;
+    DiskHead h; memset(&h, 0, sizeof h); h.key = k; h.w = (uint16_t)r.w; h.h = (uint16_t)r.h; h.len = (uint32_t)n;
+    h.crc = (uint32_t)crc32(0, z.data(), (uInt)n);
+    if (g_ld.dataSize + sizeof h + n > g_ld.maxBytes) return;   // (full: what is there is still read)
+    DiskSlot e{diskHash(k), (uint32_t)g_ld.dataSize, (uint32_t)n};
+    if (fwrite(&h, sizeof h, 1, g_ld.dataW) != 1 || fwrite(z.data(), 1, n, g_ld.dataW) != n) { g_ld.on = false; return; }
+    if (fwrite(&e, sizeof e, 1, g_ld.indexW) != 1) { g_ld.on = false; return; }
+    g_ld.dataSize += sizeof h + n; diskInsert(e); g_ld.pending = true;
+    g_ld.stored++; g_ld.writeBytes += sizeof h + n;
+    g_ld.writeMs += std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+}
+void diskFlush() {   // after pieces were written: the pixels first, then their index entries
+    if (!g_ld.pending) return;
+    fflush(g_ld.dataW); fflush(g_ld.indexW); g_ld.pending = false;
+}
+// a piece rasterized now: written later, in the time between ticks (leafDiskIdle), so that the room's entry doesn't
+// wait for its compression; at once if the queue is full (512 KB of pixels)
+void diskQueue(const DiskKey& k, const LeafRaster& r) {
+    size_t b = r.px.size() * 4;
+    if (g_ld.queueBytes + b > g_ld.queueMax) { diskWrite(k, r); diskFlush(); return; }
+    g_ld.queue.push_back({k, r}); g_ld.queueBytes += b;
+}
+// the missing pieces that are on the card: out[i] set for those read
+void diskFetch(const std::vector<const LeafPlan*>& miss, std::vector<LeafRaster*>& out) {
+    struct Want { size_t i; DiskKey k; DiskSlot e; };
+    std::vector<Want> want;
+    for (size_t i = 0; i < miss.size(); i++) {
+        Want w; w.i = i;
+        if (!diskKeyOf(*miss[i], w.k)) continue;
+        if (DiskSlot* e = diskFind(diskHash(w.k))) if (e->len) { w.e = *e; want.push_back(w); }
+    }
+    std::sort(want.begin(), want.end(), [](const Want& a, const Want& b) { return a.e.off < b.e.off; });   // (in file order)
+    for (auto& w : want) {
+        LeafRaster* r = new LeafRaster();
+        if (diskRead(w.k, w.e, *r) && r->w == miss[w.i]->w && r->h == miss[w.i]->h) { out[w.i] = r; g_ld.hits++; }
+        else { delete r; g_ld.bad++; if (DiskSlot* e = diskFind(w.e.hash)) e->len = 0; }   // (not used again: rasterized)
+    }
+}
+bool diskReadHead(FILE* f, const DiskFileHead& want) {
+    DiskFileHead h; return f && fread(&h, sizeof h, 1, f) == 1 && !memcmp(&h, &want, sizeof h);
+}
+// this build of the program: the linker's build ID (NT_GNU_BUILD_ID, -Wl,--build-id), else the program file's size
+// and time
+void buildIdentity(uint8_t out[20]) {
+    memset(out, 0, 20);
+    dl_iterate_phdr([](struct dl_phdr_info* info, size_t, void* data) -> int {   // (the program itself comes first)
+        for (int i = 0; i < info->dlpi_phnum; i++) {
+            const auto& ph = info->dlpi_phdr[i];
+            if (ph.p_type != PT_NOTE) continue;
+            const char* p = (const char*)(info->dlpi_addr + ph.p_vaddr); const char* e = p + ph.p_memsz;
+            while (p + 12 <= e) {
+                uint32_t nsz, dsz, type; memcpy(&nsz, p, 4); memcpy(&dsz, p + 4, 4); memcpy(&type, p + 8, 4);
+                const char* name = p + 12; const char* desc = name + ((nsz + 3) & ~3u);
+                if (desc + dsz > e) break;
+                if (type == 3 && nsz == 4 && !memcmp(name, "GNU", 4) && dsz) { memcpy(data, desc, std::min<uint32_t>(dsz, 20)); return 1; }
+                p = desc + ((dsz + 3) & ~3u);
+            }
+        }
+        return 1;
+    }, out);
+    static const uint8_t zero[20] = {};
+    if (memcmp(out, zero, 20)) return;
+    struct stat st;
+    if (stat("/proc/self/exe", &st) == 0) { uint64_t a = (uint64_t)st.st_size, b = (uint64_t)st.st_mtime; memcpy(out, &a, 8); memcpy(out + 8, &b, 8); }
+}
+}  // namespace
+
+void leafDiskOpen(const std::string& dir, uint32_t swfLen) {
+    if (getenv("ISAAC_NO_LEAFDISK")) { logf("[leafdisk] off (ISAAC_NO_LEAFDISK)\n"); return; }
+    for (auto& m : modsAll()) if (m.enabled) { logf("[leafdisk] off: mods are on (some change shapes)\n"); return; }
+    DiskFileHead want; memset(&want, 0, sizeof want);
+    memcpy(want.magic, "ISAACLV1", 8); want.version = 1; want.sub = (uint32_t)leafSub(); want.swfLen = swfLen;
+    buildIdentity(want.build);
+    struct stat st;
+    const std::string base = dir + "leaves_" + std::to_string(swfLen), dp = base + ".data", ip = base + ".index";
+    DiskFileHead wantI = want; wantI.which = 1;
+    uint64_t dataSize = stat(dp.c_str(), &st) == 0 ? (uint64_t)st.st_size : 0;
+    bool keep = false; std::vector<DiskSlot> entries;
+    {
+        FILE* d = fopen(dp.c_str(), "rb"); FILE* x = fopen(ip.c_str(), "rb");
+        keep = diskReadHead(d, want) && diskReadHead(x, wantI);
+        if (keep) { DiskSlot e; while (fread(&e, sizeof e, 1, x) == 1) if (e.hash && (uint64_t)e.off + sizeof(DiskHead) + e.len <= dataSize) entries.push_back(e); }
+        if (d) fclose(d); if (x) fclose(x);
+    }
+    if (!keep) {   // another build or game, or none yet: afresh
+        remove(dp.c_str()); remove(ip.c_str());
+        FILE* d = fopen(dp.c_str(), "wb"); FILE* x = fopen(ip.c_str(), "wb");
+        bool ok = d && x && fwrite(&want, sizeof want, 1, d) == 1 && fwrite(&wantI, sizeof wantI, 1, x) == 1;
+        if (d) fclose(d); if (x) fclose(x);
+        if (!ok) { logf("[leafdisk] off: cannot write %s\n", dp.c_str()); return; }
+        dataSize = sizeof want;
