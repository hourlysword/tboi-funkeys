@@ -193,7 +193,15 @@ Str* intern(std::string_view sv) {
 Str* internWeak(std::string_view sv) {
     if (!g_intern) g_intern = new std::unordered_map<std::string_view, Str*, SVHash>(1 << 14);
     auto it = g_intern->find(sv);
-    if (it != g_intern->end()) return it->second;
+    if (it != g_intern->end()) {
+        // A weak name found again while the collector frees the garbage tick by tick (lazy sweep) may be garbage still
+        // waiting to be freed: a name that comes back (the game's sound clips count from 1 again: "sz1"...) would
+        // then be freed under its new clip. Marked, it is kept through this sweep (alive or not: at worst one
+        // collection later).
+        Str* f = it->second;
+        if (f->weakAtom && !g_sweep.empty()) f->marked = 1;
+        return f;
+    }
     Str* s = new Str(std::string(sv));
     s->onHeap = 1; s->weakAtom = 1; s->interned = true; s->atom = s;
     classify(s);
