+// a row of premultiplied pixels over the destination: blendOver on each, 8 at a time with NEON (the same results:
+// d * (255 - a) / 255 rounded as (x + 128 + (x >> 8)) >> 8, which also leaves d as it is where s is 0 and gives s
+// where a is 255). rev: the source is read backwards from src (mirrored drawing).
+inline void blendRow(uint32_t* dst, const uint32_t* src, int n, bool rev = false) {
+    int i = 0;
+#if defined(__ARM_NEON)
+    for (; i + 8 <= n; i += 8) {
