+// ---------------------------------------------------------------- the version picker
+// Several versions of the game in FunKey/isaac (Isaac.exe, Isaac-Eternal.exe...: main.cpp finds them, as upstream does
+// on a PC): which one to play, asked before it is loaded, in the menu's style on black: one version at a time in the
+// box, Up and Down to the others (sliding in, held: again after 0.5 s, then every 0.1 s), A or Start plays it
+// ("Loading..." stays until the game shows), Menu quits. main.cpp keeps the choice in isaac.ini (game = og, wotl or
+// eternal) and offers it first the next time.
+// Tests: ISAAC_FUNKEY_PICK_SHOTS=<prefix> writes each version's picture and then "Loading..." into <prefix>0.ppm,
+// <prefix>1.ppm... and takes the version offered first, without waiting for a button; main.cpp's ISAAC_FUNKEY_PICK_TEST.
+struct PickState { std::vector<std::string> names; bool loading = false; } g_pick;
+float textWidth(const std::string& s, float size) {
+    if (!g_menu.bold) return (float)s.size() * 6 * (size > 18 ? 3 : 2);
+    plutovg_rect_t ext;
+    return plutovg_font_face_text_extents(g_menu.bold, size, s.c_str(), -1, PLUTOVG_TEXT_ENCODING_UTF8, &ext);
+}
+// a name in capitals, on one line or, too wide for the box, two (split at the space that leaves the longer one shortest)
+std::vector<std::string> pickLines(const std::string& name, float size) {
+    std::string up = name; for (auto& c : up) c = (char)toupper((unsigned char)c);
+    const float maxW = BOX_W - 16;
+    if (textWidth(up, size) <= maxW) return {up};
+    std::vector<std::string> best = {up}; float bestW = 1e9f;
+    for (size_t i = up.find(' '); i != std::string::npos; i = up.find(' ', i + 1)) {
+        std::string a = up.substr(0, i), b = up.substr(i + 1);
+        float w = std::max(textWidth(a, size), textWidth(b, size));
+        if (w < bestW) { bestW = w; best = {a, b}; }
+    }
+    return best;
+}
+void pickItem(plutovg_canvas_t* cv, int i, float dy) {   // a version in its box, dy pixels below its place
+    menuBox(cv, dy);
+    float mid = MH / 2.f + dy;
+    std::vector<std::string> lines = pickLines(g_pick.names[i], 22);
+    float y = mid - 14 - 13.f * (float)(lines.size() - 1);
+    for (auto& l : lines) { menuText(cv, l.c_str(), 22, y); y += 26; }
+    menuText(cv, g_pick.loading ? "Loading..." : "Press A to play", 16, mid + 2 * LINE);
+}
+// the version chosen (an index of names), or -1: Menu pressed, the game asked to stop or the console powering off
+int pickRun(const std::vector<std::string>& names, int sel) {
+    menuFonts();
+    g_pick.names = names; g_pick.loading = false;
+    g_menu.dim.assign((size_t)MW * MH, 0xff000000u);   // (nothing behind it yet)
+    const int n = (int)names.size();
+    sel = std::max(0, std::min(n - 1, sel));
+    if (const char* p = getenv("ISAAC_FUNKEY_PICK_SHOTS")) {   // (tests) each version's picture, then "Loading..."
+        for (int i = 0; i <= n; i++) {
+            g_pick.loading = i == n;
+            boxDraw(i < n ? i : sel, 0, 0, 0, pickItem, !g_pick.loading);
+            writePpm((p + std::to_string(i) + ".ppm").c_str());
+        }
+        return sel;
+    }
+    if (!g_screen || g_inputFds.empty()) { logf("[funkey] version picker: no %s\n", g_screen ? "buttons" : "screen"); return sel; }
+    int prev = sel, slide = 0, dir = 0, held = -1, chosen = -2; double repeatAt = 0; bool dirty = true;
+    auto move = [&](int d) { prev = sel; sel = (sel + d + n) % n; dir = d; slide = 30; };
+    while (chosen == -2 && !g_stopReq && !g_powerReq) {
+        inputPoll([&](int b, bool d) {
+            if (!d) { if (b == held) held = -1; return; }
+            if (chosen != -2) return;
+            switch (b) {
+                case B_UP: case B_DOWN: if (slide == 0) { move(b == B_DOWN ? 1 : -1); held = b; repeatAt = now() + 0.5; } break;
+                case B_A: case B_START: chosen = sel; break;
+                case B_MENU: chosen = -1; break;
+                default: break;
+            }
+        });
+        if (chosen == -1) break;
+        if (chosen >= 0) { slide = 0; g_pick.loading = true; dirty = true; }   // (the last picture: "Loading...")
+        double t = now();
+        if (chosen == -2 && held >= 0 && slide == 0 && t >= repeatAt) { move(held == B_DOWN ? 1 : -1); repeatAt = t + 0.1; }
+        if (dirty || slide > 0) {
+            boxDraw(sel, prev, slide, dir, pickItem, !g_pick.loading);
+            fbPresent(g_menu.out.data(), MW, MH);
+            dirty = false;
+            if (slide > 0 && (slide += 30) >= MH) { slide = 0; dirty = true; }
+            if (chosen == -2) inputWait(0.02);   // (50 pictures a second while sliding)
+        } else {
+            fbKeepShown();
+            inputWait(0.05);
+        }
+    }
+    return chosen >= 0 ? chosen : -1;
+}
