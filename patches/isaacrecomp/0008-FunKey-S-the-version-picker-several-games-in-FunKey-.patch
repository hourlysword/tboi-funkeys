+// which version to play when FunKey/isaac holds several (their names; `initial` offered first): the index chosen, or
+// -1 to quit (main.cpp then calls funkeyFinish(), for a power-off)
+int funkeyChooseGame(const std::vector<std::string>& names, int initial) {
+    if (names.empty()) return -1;
+    ioOpen();
+    initial = std::max(0, std::min((int)names.size() - 1, initial));
+    logf("[funkey] version picker: %zu versions, %s offered first\n", names.size(), names[initial].c_str());
+    int c = pickRun(names, initial);
+    logf("[funkey] version picker: %s\n", c >= 0 ? names[c].c_str() : g_powerReq ? "the console is powering off" : g_stopReq ? "asked to stop" : "Menu: quit");
+    if (c < 0 && g_screen && !g_powerReq) { memset(g_fb.mem, 0, g_fb.size); fbPan(); }
+    return c;
+}
