@@ -358,6 +364,45 @@ std::string iniGet(const std::string& key) {   // ("" when absent)
     }
     return "";
 }
+std::string iniGet(const std::string& key) { return cfgGet(iniPath(), key); }   // ("" when absent)
+
+// ---------------------------------------------------------------- the CPU clock (OVERCLOCK in the menu)
+// The launcher (opk/isaac.sh) runs the game at the system's own clock unless FunKey/isaac/launcher.cfg asks for another
+// (cpu_mhz = 1296: OVERCLOCK on), puts the system's clock back when the game ends, and passes its clock tool
+// (ISAAC_FUNKEY_CPUCLOCK) and the system's clock (ISAAC_FUNKEY_SYSTEM_MHZ). OVERCLOCK in the menu switches between the
+// two at once and keeps the choice in launcher.cfg for the next start; without the tool (a PC, the play tests) the
+// choice is only kept.
+constexpr int kOverclockMhz = 1296;
+struct CpuClock { std::string tool; int system = 0; bool on = false; } g_clock;
+std::string launcherCfg() { std::string p = iniPath(); return p.substr(0, p.size() - strlen("isaac.ini")) + "launcher.cfg"; }
+int clockNow() {   // the CPU clock in MHz (0: unknown)
+    if (g_clock.tool.empty()) return 0;
+    FILE* p = popen(("\"" + g_clock.tool + "\" 2> /dev/null").c_str(), "r");
+    if (!p) return 0;
+    int v = 0; if (fscanf(p, "%d", &v) != 1) v = 0;
+    pclose(p);
+    return v;
+}
+void clockInit() {
+    const char* tool = getenv("ISAAC_FUNKEY_CPUCLOCK"); const char* sys = getenv("ISAAC_FUNKEY_SYSTEM_MHZ");
+    if (tool && *tool && access(tool, X_OK) == 0) g_clock.tool = tool;
+    g_clock.system = sys ? atoi(sys) : 0;
+    const int cur = clockNow();
+    const std::string cfg = cfgGet(launcherCfg(), "cpu_mhz");   // (no file: off)
+    g_clock.on = cur > 0 && g_clock.system > 0 ? cur > g_clock.system : !cfg.empty() && cfg != "0";
+    logf("[funkey] CPU clock %d MHz, the system's %d MHz: OVERCLOCK %s\n", cur, g_clock.system, g_clock.on ? "ON" : "OFF");
+}
+void clockSet(bool on) {
+    g_clock.on = on;
+    saveIniValue(launcherCfg(), "cpu_mhz", on ? std::to_string(kOverclockMhz) : "0");
+    if (!g_clock.tool.empty() && g_clock.system > 0) {
+        const std::string mhz = std::to_string(on ? kOverclockMhz : g_clock.system);
+        const char* argv[] = {g_clock.tool.c_str(), mhz.c_str(), nullptr};
+        pid_t pid = 0;
+        if (posix_spawn(&pid, g_clock.tool.c_str(), nullptr, nullptr, (char* const*)argv, environ) == 0) waitpid(pid, nullptr, 0);
+    }
+    logf("[funkey] menu: OVERCLOCK %s, CPU clock %d MHz\n", on ? "ON" : "OFF", clockNow());
+}
 
