+#ifdef ISAAC_FUNKEY
+// (FunKey: memory) A lossless bitmap more than 1024 pixels on a side, decoded in strips and shrunk on the fly by a power
+// of 2 (box average of premultiplied pixels): the Eternal Edition's largest, 3000x3000 (the light over every room),
+// would take 35 MB decoded and as much again for its zlib data while decoding, on a console with 45 MB. Only the
+// renderer reads these (raster.cpp scales its fill matrix by `down`): the game's logic never decodes it.
+static bool decodeShrunk(BitmapDef& b, const uint8_t* z, size_t zlen, int fmt, int ncol) {
+    if (fmt != 5 && fmt != 3) return false;
+    int k = 1; while (std::max(b.w, b.h) / k > 1024) k *= 2;
+    const int ow = (b.w + k - 1) / k, oh = (b.h + k - 1) / k;
+    z_stream zs; memset(&zs, 0, sizeof zs);
+    if (inflateInit(&zs) != Z_OK) return false;
+    zs.next_in = (Bytef*)z; zs.avail_in = (uInt)zlen;
+    auto readN = [&](uint8_t* dst, size_t n) {   // exactly n bytes (zeros past the end of the data)
+        zs.next_out = dst; zs.avail_out = (uInt)n;
+        while (zs.avail_out) { int rc = inflate(&zs, Z_NO_FLUSH); if (rc != Z_OK) break; }
+        if (zs.avail_out) memset(zs.next_out, 0, zs.avail_out);
+    };
+    const bool alpha = b.tag == 36;
+    std::vector<uint32_t> pal;
+    if (fmt == 3) {   // (Lossless2: palette colours already premultiplied)
