+
+extern char** environ;
+
+namespace fl {
+void runIntervals(); void recompPatchesTick(); bool recompInGameplay(bool* inGame);
+void debugEval(const std::string&);
+extern uint32_t g_shapeTick; void rasterTrim(size_t budget);
+const uint32_t* renderSoftOutput(int* w, int* h);
+void leanStats(size_t* shapeBytes, size_t* soundBytes); void renderMemStats(size_t* pages, size_t* bitmaps);
+
+namespace {
+double now() { timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts); return ts.tv_sec + ts.tv_nsec / 1e9; }
+double threadCpuMs() { timespec ts; clock_gettime(CLOCK_THREAD_CPUTIME_ID, &ts); return ts.tv_sec * 1e3 + ts.tv_nsec / 1e6; }
+// a log line written at once (the signal thread must not wait on stdio's lock)
+void rawLog(const char* fmt, ...) {
+    char line[512]; va_list ap; va_start(ap, fmt); int n = vsnprintf(line, sizeof line - 1, fmt, ap); va_end(ap);
+    if (n < 0) return;
+    if (n > (int)sizeof line - 2) n = (int)sizeof line - 2;
+    line[n++] = '\n';
+    if (write(STDERR_FILENO, line, n) < 0) {}
+}
+
+// ---------------------------------------------------------------- the text console
+int g_ttyMode = -1, g_kbMode = -1;
+void takeConsole() {
+    int fd = open("/dev/tty0", O_RDWR | O_CLOEXEC);
+    if (fd < 0) return;
+    if (ioctl(fd, KDGETMODE, &g_ttyMode) != 0) g_ttyMode = KD_TEXT;
+    if (ioctl(fd, KDGKBMODE, &g_kbMode) != 0) g_kbMode = -1;
+    ioctl(fd, KDSETMODE, KD_GRAPHICS);   // (no cursor, no console text over the picture)
+    if (g_kbMode >= 0 && g_kbMode != K_OFF) ioctl(fd, KDSKBMODE, K_OFF);   // (the buttons don't type into it)
+    close(fd);
+}
+void restoreConsole() {   // (async-signal-safe: the crash handler calls it)
+    if (g_ttyMode < 0) return;
+    int fd = open("/dev/tty0", O_RDWR | O_CLOEXEC);
+    if (fd < 0) return;
+    if (g_kbMode >= 0 && g_kbMode != K_OFF) ioctl(fd, KDSKBMODE, g_kbMode);
+    ioctl(fd, KDSETMODE, g_ttyMode);
+    tcflush(fd, TCIFLUSH);   // (whatever was typed into it meanwhile)
+    close(fd);
+    g_ttyMode = -1;
+}
+
+// ---------------------------------------------------------------- the screen
+struct Fb { int fd = -1; uint8_t* mem = nullptr; size_t size = 0; int w = 0, h = 0, bpp = 0, line = 0; double panned = 0; } g_fb;
+std::string g_notification;   // the driver's overlay (sysfs), "" if none
+bool fbOpen(std::string& desc) {
+    const char* path = getenv("ISAAC_FUNKEY_FB") ? getenv("ISAAC_FUNKEY_FB") : "/dev/fb0";
+    g_fb.fd = open(path, O_RDWR | O_CLOEXEC);
+    if (g_fb.fd < 0) { desc = std::string("no screen: ") + path + ": " + strerror(errno); return false; }
+    fb_var_screeninfo var; fb_fix_screeninfo fix;
+    if (ioctl(g_fb.fd, FBIOGET_VSCREENINFO, &var) != 0 || ioctl(g_fb.fd, FBIOGET_FSCREENINFO, &fix) != 0) {
+        desc = std::string(path) + " is not a framebuffer"; close(g_fb.fd); g_fb.fd = -1; return false;
+    }
+    bool rgb565 = var.bits_per_pixel == 16 && var.red.offset == 11 && var.green.offset == 5;
+    bool xrgb = var.bits_per_pixel == 32 && var.red.offset == 16 && var.green.offset == 8;
+    if (!rgb565 && !xrgb) { desc = std::string(path) + ": unsupported pixel format"; close(g_fb.fd); g_fb.fd = -1; return false; }
+    g_fb.w = (int)var.xres; g_fb.h = (int)var.yres; g_fb.bpp = (int)var.bits_per_pixel; g_fb.line = (int)fix.line_length;
+    // one page only: fbtft reports more memory than it backs, and the first access past one frame is a SIGBUS
+    g_fb.size = (size_t)g_fb.line * g_fb.h;
+    void* m = mmap(nullptr, g_fb.size, PROT_READ | PROT_WRITE, MAP_SHARED, g_fb.fd, 0);
+    if (m == MAP_FAILED) { desc = std::string("cannot map ") + path; close(g_fb.fd); g_fb.fd = -1; return false; }
+    g_fb.mem = (uint8_t*)m;
+    memset(g_fb.mem, 0, g_fb.size);
+    const char* name = strrchr(path, '/');
+    g_notification = std::string("/sys/class/graphics/") + (name ? name + 1 : path) + "/notification";
+    if (access(g_notification.c_str(), W_OK) != 0) g_notification.clear();
+    char b[160]; snprintf(b, sizeof b, "%s: %dx%d, %d bits per pixel, line %d bytes%s", path, g_fb.w, g_fb.h, g_fb.bpp, g_fb.line,
+                          g_notification.empty() ? "" : ", notification overlay");
+    desc = b;
+    return true;
+}
+void fbPan() {
+    if (g_fb.fd < 0) return;
+    fb_var_screeninfo var;
+    if (ioctl(g_fb.fd, FBIOGET_VSCREENINFO, &var) != 0) return;
+    var.xoffset = 0; var.yoffset = 0;
+    if (ioctl(g_fb.fd, FBIOPAN_DISPLAY, &var) != 0) {}   // (fbtft takes the picture and answers ENODEV: nothing to check)
+    g_fb.panned = now();
+}
+void fbKeepShown() { if (g_fb.mem && now() - g_fb.panned >= 0.1) fbPan(); }   // (within the driver's 1/9 s)
+// The output frame (ARGB) onto the screen, in RGB565 with a 4x4 ordered dither (the stage's dark gradients would show
+// bands otherwise)
+void fbPresent(const uint32_t* px, int w, int h) {
+    if (!g_fb.mem || !px) return;
+    static const uint8_t kBayer[4][4] = {{0, 8, 2, 10}, {12, 4, 14, 6}, {3, 11, 1, 9}, {15, 7, 13, 5}};
+    int cw = std::min(w, g_fb.w), ch = std::min(h, g_fb.h);
+    for (int y = 0; y < ch; y++) {
+        const uint32_t* s = px + (size_t)y * w;
+        if (g_fb.bpp == 16) {
+            uint16_t* d = (uint16_t*)(g_fb.mem + (size_t)y * g_fb.line);
+            const uint8_t* bay = kBayer[y & 3];
+            for (int x = 0; x < cw; x++) {
+                uint32_t c = s[x], t = bay[x & 3];
+                uint32_t r = ((c >> 16) & 255) + (t >> 1), g = ((c >> 8) & 255) + (t >> 2), b = (c & 255) + (t >> 1);
+                if (r > 255) r = 255; if (g > 255) g = 255; if (b > 255) b = 255;
+                d[x] = (uint16_t)((r >> 3) << 11 | (g >> 2) << 5 | (b >> 3));
+            }
+        } else memcpy(g_fb.mem + (size_t)y * g_fb.line, s, (size_t)cw * 4);
+    }
+    fbPan();
+}
+void notify(const std::string& text) {   // "" clears it
+    if (g_notification.empty()) return;
+    int fd = open(g_notification.c_str(), O_WRONLY | O_CLOEXEC);
+    if (fd < 0) return;
+    std::string t = text.empty() ? std::string("clear") : text.substr(0, 400);
+    if (write(fd, t.data(), t.size()) < 0) {}
+    close(fd);
+    fbPan();   // (the driver draws the overlay into each picture it's handed)
+}
+
+// ---------------------------------------------------------------- the buttons
+enum Btn { B_UP, B_DOWN, B_LEFT, B_RIGHT, B_A, B_B, B_X, B_Y, B_L, B_R, B_START, B_FN, B_MENU, B_COUNT };
+std::vector<int> g_inputFds;
+std::string inputOpen() {
+    std::string desc;
+    for (int i = 0; i < 32; i++) {
+        char path[32]; snprintf(path, sizeof path, "/dev/input/event%d", i);
+        int fd = open(path, O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+        if (fd < 0) continue;
+        unsigned long bits[KEY_MAX / (8 * sizeof(unsigned long)) + 1] = {};
+        auto has = [&](int code) { return (bits[code / (8 * sizeof(unsigned long))] >> (code % (8 * sizeof(unsigned long)))) & 1; };
+        if (ioctl(fd, EVIOCGBIT(EV_KEY, sizeof bits), bits) < 0 || !has(KEY_A) || !has(KEY_Q)) { close(fd); continue; }
+        char name[128] = "?"; ioctl(fd, EVIOCGNAME(sizeof name), name);
+        desc += (desc.empty() ? "" : ", ") + std::string(path) + " (" + name + ")";
+        g_inputFds.push_back(fd);
+    }
+    return desc.empty() ? std::string("no buttons found") : desc;
+}
+int buttonOf(int code) {   // the button daemon's keys (fkgpiod.conf)
+    switch (code) {
+        case KEY_U: return B_UP; case KEY_D: return B_DOWN; case KEY_L: return B_LEFT; case KEY_R: return B_RIGHT;
+        case KEY_A: return B_A; case KEY_B: return B_B; case KEY_X: return B_X; case KEY_Y: return B_Y;
+        case KEY_M: return B_L; case KEY_N: return B_R; case KEY_S: return B_START; case KEY_K: return B_FN; case KEY_Q: return B_MENU;
+        default: return -1;
+    }
+}
+// calls f(button, down) for each press and release (auto-repeats ignored)
+template <class F> void inputPoll(F&& f) {
+    for (int fd : g_inputFds) {
+        input_event ev[32];
+        for (;;) {
+            ssize_t n = read(fd, ev, sizeof ev);
+            if (n < (ssize_t)sizeof(input_event)) break;
+            for (int i = 0; i < (int)(n / sizeof(input_event)); i++) {
+                if (ev[i].type != EV_KEY || ev[i].value == 2) continue;
+                int b = buttonOf(ev[i].code);
+                if (b >= 0) f(b, ev[i].value == 1);
+            }
+        }
+    }
+}
+void inputWait(double seconds) {   // sleep, waking early when a button changes
+    if (seconds <= 0) return;
+    std::vector<pollfd> p;
+    for (int fd : g_inputFds) p.push_back({fd, POLLIN, 0});
+    if (p.empty()) { timespec ts{(time_t)seconds, (long)((seconds - (time_t)seconds) * 1e9)}; nanosleep(&ts, nullptr); return; }
+    poll(p.data(), p.size(), (int)std::ceil(seconds * 1000));
+}
+
+// ---------------------------------------------------------------- signals: stop, power-off, crashes
+std::atomic<bool> g_stopReq{false}, g_powerReq{false}, g_powerDone{false};
+const char* kPowerdown = "/usr/local/sbin/powerdown";
+bool takeOver() { return !getenv("ISAAC_FUNKEY_NO_POWEROFF") && access(kPowerdown, X_OK) == 0; }
+pid_t spawn(const char* prog, const char* a1) {
+    const char* argv[] = {prog, a1, nullptr};
+    posix_spawnattr_t attr; posix_spawnattr_init(&attr);
+    sigset_t none, defaults; sigemptyset(&none); sigemptyset(&defaults);
+    for (int s : {SIGUSR1, SIGTERM, SIGINT, SIGHUP, SIGPIPE}) sigaddset(&defaults, s);
+    posix_spawnattr_setsigmask(&attr, &none); posix_spawnattr_setsigdefault(&attr, &defaults);
+    posix_spawnattr_setflags(&attr, POSIX_SPAWN_SETSIGMASK | POSIX_SPAWN_SETSIGDEF);
+    pid_t pid = -1;
+    if (posix_spawn(&pid, prog, nullptr, &attr, (char* const*)argv, environ) != 0) pid = -1;
+    posix_spawnattr_destroy(&attr);
+    return pid;
+}
+// the power-offs FunKey-OS has scheduled (`powerdown schedule 0.1`: a shell script sleeping before `powerdown now`)
+int killScheduled() {
+    int killed = 0;
+    DIR* d = opendir("/proc");
+    if (!d) return 0;
+    while (dirent* e = readdir(d)) {
+        int pid = atoi(e->d_name);
+        if (pid <= 1 || pid == getpid()) continue;
+        char path[64], cmd[512]; snprintf(path, sizeof path, "/proc/%d/cmdline", pid);
+        int fd = open(path, O_RDONLY | O_CLOEXEC); if (fd < 0) continue;
+        ssize_t n = read(fd, cmd, sizeof cmd - 1); close(fd);
+        if (n <= 0) continue;
+        for (ssize_t i = 0; i < n; i++) if (!cmd[i]) cmd[i] = ' ';
+        cmd[n] = 0;
+        if (strstr(cmd, "powerdown schedule") && kill(pid, SIGTERM) == 0) killed++;
+    }
+    closedir(d);
+    return killed;
+}
+void powerOffNow() {   // never returns on the console
+    restoreConsole();
+    sync();
+    if (takeOver()) { const char* argv[] = {kPowerdown, "now", nullptr}; execv(kPowerdown, (char* const*)argv); }
+    _exit(0);
+}
+sigset_t stopSignals() { sigset_t s; sigemptyset(&s); for (int x : {SIGUSR1, SIGTERM, SIGINT, SIGHUP}) sigaddset(&s, x); return s; }
+void* signalThread(void*) {
+    sigset_t set = stopSignals();
+    for (;;) {
+        siginfo_t info; int sig = sigwaitinfo(&set, &info);
+        if (sig < 0) continue;
+        if (sig != SIGUSR1) { rawLog("[funkey] signal %d from PID %d: quitting", sig, (int)info.si_pid); g_stopReq = true; continue; }
+        if (g_powerReq.exchange(true)) { int k = takeOver() ? killScheduled() : 0; rawLog("[funkey] power-off signal again: %d scheduled power-off(s) ended", k); continue; }
+        double t0 = now();
+        int killed = 0; pid_t handle = -1;
+        if (takeOver()) { killed = killScheduled(); handle = spawn(kPowerdown, "handle"); }
+        notify("   Shutting down...");
+        rawLog("[funkey] power-off signal from PID %d taken over in %.1f ms: %d scheduled power-off(s) ended, 'powerdown handle' %s",
+               (int)info.si_pid, (now() - t0) * 1000, killed, handle > 0 ? "started" : takeOver() ? "NOT started" : "not on the console");
+        while (!g_powerDone && now() - t0 < 2.5) { timespec ts{0, 20 * 1000 * 1000}; nanosleep(&ts, nullptr); }
+        if (!g_powerDone) { rawLog("[funkey] the game didn't stop within 2.5 s: powering off without saving"); powerOffNow(); }
+    }
+    return nullptr;
+}
+void crashHandler(int sig, siginfo_t* info, void* ctx) {
+    unsigned long pc = 0;
+#if defined(__arm__)
+    pc = ((ucontext_t*)ctx)->uc_mcontext.arm_pc;
+#else
+    (void)ctx;
+#endif
+    rawLog("[funkey] crash: signal %d at address %p, pc 0x%lx", sig, info ? info->si_addr : nullptr, pc);
+    restoreConsole();
+    raise(sig);   // (SA_RESETHAND: the default action now, so the launcher sees the signal in the exit status)
+}
+
+// ---------------------------------------------------------------- memory, for the log
+void memInfo(int& rssKB, int& swapKB, int& availKB) {
+    rssKB = swapKB = availKB = -1;
+    char l[160];
+    if (FILE* f = fopen("/proc/self/status", "r")) {
+        while (fgets(l, sizeof l, f)) { if (!strncmp(l, "VmRSS:", 6)) rssKB = atoi(l + 6); else if (!strncmp(l, "VmSwap:", 7)) swapKB = atoi(l + 7); }
+        fclose(f);
+    }
+    if (FILE* f = fopen("/proc/meminfo", "r")) {
+        while (fgets(l, sizeof l, f)) if (!strncmp(l, "MemAvailable:", 13)) availKB = atoi(l + 13);
+        fclose(f);
+    }
+}
+}  // namespace
+
+// ---------------------------------------------------------------- entry points
+void funkeyEarly() {
+    // the stop signals go to the signal thread only: blocked here, before any other thread exists (SDL's sound
+    // thread, the log writer), which then inherit the mask
+    sigset_t set = stopSignals();
+    pthread_sigmask(SIG_BLOCK, &set, nullptr);
+    pthread_t t; pthread_attr_t a; pthread_attr_init(&a); pthread_attr_setstacksize(&a, 64 * 1024);
+    if (pthread_create(&t, &a, signalThread, nullptr) == 0) pthread_detach(t);
+    pthread_attr_destroy(&a);
+    struct sigaction sa; memset(&sa, 0, sizeof sa);
+    sa.sa_sigaction = crashHandler; sa.sa_flags = SA_SIGINFO | SA_RESETHAND; sigemptyset(&sa.sa_mask);
+    for (int s : {SIGSEGV, SIGBUS, SIGILL, SIGFPE, SIGABRT}) sigaction(s, &sa, nullptr);
+}
+
+uint64_t funkeyPlay(bool perfOverlay) {   // (returns the number of pictures drawn)
+    uint64_t drawn = 0;
+    std::string fbDesc;
+    bool screen = fbOpen(fbDesc);
+    logf("[funkey] %s\n", fbDesc.c_str());
+    logf("[funkey] buttons: %s\n", inputOpen().c_str());
+    if (screen) takeConsole();
+    int outW = screen ? g_fb.w : 240, outH = screen ? g_fb.h : 240;
+
+    // ---- the test script (ISAAC_FUNKEY_SCRIPT): headless test scripts' commands, by tick
+    struct Cmd { uint32_t tick; std::string op, arg; };
+    std::vector<Cmd> script; size_t scriptPos = 0;
+    if (const char* sp = getenv("ISAAC_FUNKEY_SCRIPT")) {
+        std::ifstream f(sp); std::string line;
+        while (std::getline(f, line)) { std::istringstream ss(line); Cmd c; if (ss >> c.tick >> c.op) { std::getline(ss, c.arg); size_t i = c.arg.find_first_not_of(' '); c.arg = i == std::string::npos ? "" : c.arg.substr(i); script.push_back(c); } }
+        logf("[funkey] test script %s: %zu commands (the buttons are ignored)\n", sp, script.size());
+    }
+    const bool scripted = !script.empty();
+    static const bool marks = getenv("ISAAC_TICKMARKS") != nullptr;
+
+    // ---- buttons -> the game's keys. In play: D-pad moves (WASD), X A B Y shoot up, right, down, left (arrows), L bomb
+    // (E), R the active item (space), Fn a card or pill (Q, when let go without another button: Fn combos are the
+    // system's), Start pause (P). Menus and the pause screen: D-pad chooses, A confirms, B goes back (menuui.cpp).
+    struct Map { int game, pause, menu; };
+    static const Map kMap[B_COUNT] = {
+        {'W', 0, 0}, {'S', 0, 0}, {'A', 0, 0}, {'D', 0, 0},     // D-pad (menus: navigation)
+        {39, 0, 0}, {40, 0, 0}, {38, 38, 0}, {37, 37, 0},        // A B X Y (menus: A confirm, B back)
+        {'E', 0, 0}, {32, 0, 0}, {'P', 'P', 13}, {'Q', 'P', 27}, {0, 0, 0},   // L R Start Fn Menu
+    };
+    int keyRefs[256] = {0}, held[B_COUNT] = {0};
+    auto keyDown = [&](int c) { if (c > 0 && c < 256 && keyRefs[c]++ == 0) keyEvent(c, (c == 32 || c == 13 || c == 27) ? c : 0, true); };
+    auto keyUp = [&](int c) { if (c > 0 && c < 256 && keyRefs[c] > 0 && --keyRefs[c] == 0) keyEvent(c, 0, false); };
+    bool down[B_COUNT] = {};
+    bool fnAlone = false; double fnAt = 0; int pulseKey = 0; uint32_t pulseUntil = 0;
+    int navDir = -1; double navNext = 0;
+    double menuAt = -10; bool quit = false;
+    auto onButton = [&](int b, bool isDown) {
+        down[b] = isDown;
+        if (b == B_MENU) {
+            if (!isDown) return;
+            double t = now();
+            if (t - menuAt < 2.5) { quit = true; return; }
+            menuAt = t; notify("Press MENU again^to quit");
+            return;
+        }
+        if (b == B_FN) {   // a card or pill when let go, if no other button was pressed meanwhile
+            if (isDown) { fnAlone = true; fnAt = now(); return; }
+            if (!fnAlone || now() - fnAt > 0.6) return;
+            fnAlone = false;
+            bool ig = false, play = recompInGameplay(&ig);
+            int code = play ? kMap[B_FN].game : ig ? kMap[B_FN].pause : kMap[B_FN].menu;
+            if (code && !pulseKey) { keyDown(code); pulseKey = code; pulseUntil = g_player.tick + 2; }
+            return;
+        }
+        if (isDown) fnAlone = false;
+        if (!isDown) { if (held[b]) keyUp(held[b]); held[b] = 0; return; }
+        bool ig = false, play = recompInGameplay(&ig);
+        if (!play) {   // menus and the pause screen: the controller outline
+            if (b == B_A) { padNavEvent(NAV_CONFIRM); return; }
+            if (b == B_B) { padNavEvent(NAV_BACK); return; }
+            if (b <= B_RIGHT) return;   // (navigation, with repeat: below)
+        }
+        int code = play ? kMap[b].game : ig ? kMap[b].pause : kMap[b].menu;
+        if (code) { held[b] = code; keyDown(code); }
+    };
+
+    // ---- the loop
+    const double dt = 1.0 / g_frameRate;
+    double next = now(), clockStart = next;
+    int skipped = 0;   // pictures skipped in a row
+    // statistics, logged every 5 s (and drawn over the picture with performance = 1)
+    struct Win { int ticks = 0, frames = 0, skipped = 0, stalls = 0; double logic = 0, draw = 0, present = 0, gc = 0, worst = 0; } w;
+    double winStart = now();
+    std::vector<std::string> perfLines;
+    if (screen) notify("");
+    while (!quit && !g_stopReq && !g_powerReq && !g_player.quit) {
+        // buttons (or the script)
+        if (scripted) {
+            while (scriptPos < script.size() && script[scriptPos].tick <= g_player.tick) {
+                const Cmd& c = script[scriptPos++];
+                if (c.op == "down") keyEvent(atoi(c.arg.c_str()), atoi(c.arg.c_str()) == 32 ? 32 : 0, true);
+                else if (c.op == "up") keyEvent(atoi(c.arg.c_str()), 0, false);
+                else if (c.op == "click") { double x = 0, y = 0; sscanf(c.arg.c_str(), "%lf %lf", &x, &y); mouseEvent(x, y, 0); mouseEvent(x, y, 1); mouseEvent(x, y, 2); }
+                else if (c.op == "eval") debugEval(c.arg);
+                else if (c.op == "shot") renderScreenshot(c.arg.c_str());   // (the last picture shown)
+                else if (c.op == "quit") quit = true;
+            }
+            inputPoll([&](int b, bool d) { if (b == B_MENU) onButton(b, d); });   // (Menu still quits)
+        } else {
+            inputPoll(onButton);
+            bool ig = false, play = recompInGameplay(&ig);
+            if (!play) {   // menu navigation with the D-pad, repeating while held
+                int dir = down[B_UP] ? NAV_UP : down[B_DOWN] ? NAV_DOWN : down[B_LEFT] ? NAV_LEFT : down[B_RIGHT] ? NAV_RIGHT : -1;
+                double t = now();
+                if (dir != navDir) { navDir = dir; if (dir >= 0) { padNavEvent(dir); navNext = t + 0.40; } }
+                else if (dir >= 0 && t >= navNext) { padNavEvent(dir); navNext = t + 0.12; }
+            } else navDir = -1;
+            if (pulseKey && g_player.tick >= pulseUntil) { keyUp(pulseKey); pulseKey = 0; }
+        }
+        if (quit) break;
+        if (menuAt > 0 && now() - menuAt >= 2.5) { menuAt = -10; notify(""); }
+
+        // one logic tick
+        g_player.timeMs = scripted ? g_player.tick * 1000.0 / g_frameRate : (now() - clockStart) * 1000.0;
+        if (marks) logf("OFKMEM begin %u\n", g_player.tick);
+        double t0 = now(), c0 = threadCpuMs();
+        g_shapeTick = g_player.tick;
+        runFrame(); runIntervals(); recompPatchesTick(); modsTick();
+        { bool ig = false, gp = recompInGameplay(&ig); menuUiTick(gp, ig); }
+        double t1 = now();
+        if (marks) logf("OFKMEM tick %u ents -1 ms %.3f cpu %.3f objs %zu\n", g_player.tick, (t1 - t0) * 1000, threadCpuMs() - c0, gcCount());
+        w.logic += (t1 - t0) * 1000; w.ticks++;
+
+        // the picture, unless behind the clock (never more than 3 in a row skipped)
+        bool behind = t1 > next + dt;
+        if (!behind || skipped >= 3) {
+            if (marks) logf("OFKMEM dbegin %u\n", g_player.tick);
+            double d0 = now(), dc0 = threadCpuMs();
+            g_rstats = RenderStats();
+            SnapPtr snap = buildSnapshot(); menuUiFill(*snap);
+            renderAdopt(snap);
+            renderFrame(outW, outH, 1.0);
+            if (perfOverlay) renderOverlay(perfLines);
+            renderEndFrame();
+            double d1 = now();
+            int ow, oh; const uint32_t* out = renderSoftOutput(&ow, &oh);
+            fbPresent(out, ow, oh);
+            double d2 = now();
+            if (marks) logf("OFKMEM draw %u ms %.3f cpu %.3f rasters %d quads %d present %.3f\n", g_player.tick, (d2 - d0) * 1000, threadCpuMs() - dc0, g_rstats.rasters, g_rstats.quads, (d2 - d1) * 1000);
+            w.draw += (d1 - d0) * 1000; w.present += (d2 - d1) * 1000; w.frames++; drawn++;
+            skipped = 0;
+        } else { skipped++; w.skipped++; fbKeepShown(); }
+
+        static const long memLog = getenv("ISAAC_FUNKEY_MEMLOG") ? atol(getenv("ISAAC_FUNKEY_MEMLOG")) : 0;   // (testing) memory, tick by tick
+        if ((long)g_player.tick < memLog) {
+            int rss, swap, avail; memInfo(rss, swap, avail);
+            size_t shp, snd, pages, bms; leanStats(&shp, &snd); renderMemStats(&pages, &bms);
+            logf("[funkey] tick %u: rss %d KB, swap %d KB | parsed shapes %zu KB, sounds %zu KB, rasters %zu KB, frame buffers %zu KB, GC objects %zu\n",
+                 g_player.tick, rss, swap, shp >> 10, snd >> 10, pages >> 10, bms >> 10, gcCount());
+        }
+        // the collector, after the picture (so that it never delays one)
+        double g0 = now();
+        gcCollect((g0 - t0) * 1000);
+        rasterTrim(4u << 20);   // (decoded SWF bitmaps: 4 MB, so that the shrunk 750x750 light over the rooms stays)
+        double g1 = now();
+        w.gc += (g1 - g0) * 1000;
+        w.worst = std::max(w.worst, (g1 - t0) * 1000);
+
+        // the clock: one tick every 1/30 s; a stall of more than half a second (a room being built) isn't caught up
+        next += dt;
+        double t = now();
+        if (t < next) inputWait(next - t);
+        else if (t > next + 0.5) { next = t; w.stalls++; }
+
+        if (t - winStart >= 5) {
+            int rss, swap, avail; memInfo(rss, swap, avail);
+            double secs = t - winStart; int n = std::max(1, w.ticks), nf = std::max(1, w.frames);
+            logf("[funkey] %.1f s: %.1f ticks/s, %.1f pictures/s (%d skipped), stalls %d | per tick: logic %.1f ms, gc %.1f; per picture: draw %.1f, present %.1f; worst tick %.0f ms | rss %d MB, swap %d MB, available %d MB\n",
+                 secs, w.ticks / secs, w.frames / secs, w.skipped, w.stalls, w.logic / n, w.gc / n, w.draw / nf, w.present / nf, w.worst, rss >> 10, swap >> 10, avail >> 10);
+            if (perfOverlay) {
+                char a[64], b[64], c[64];
+                snprintf(a, sizeof a, "%.0f TPS %.0f FPS", w.ticks / secs, w.frames / secs);
+                snprintf(b, sizeof b, "LOGIC %.1f DRAW %.1f GC %.1f", w.logic / n, w.draw / nf, w.gc / n);
+                snprintf(c, sizeof c, "RSS %d MB SWAP %d", rss >> 10, swap >> 10);
+                perfLines = {a, b, c};
+            }
+            w = Win(); winStart = t;
+        }
+    }
+    if (g_powerReq) logf("[funkey] stopping for the power-off\n");
+    else if (g_stopReq) logf("[funkey] stopping: asked to\n");
+    else logf("[funkey] quitting (Menu twice, or the game)\n");
+    if (screen) { if (!g_powerReq) notify(""); memset(g_fb.mem, 0, g_fb.size); fbPan(); }
+    restoreConsole();
+    return drawn;
+}
+
+// after the save: the power-off, if one was asked for (does not return then)
+void funkeyFinish() {
+    restoreConsole();
+    if (!g_powerReq) return;
+    logf("[funkey] saved: powering off\n");
+    g_powerDone = true;
+    powerOffNow();
+}
+}  // namespace fl
+#endif
