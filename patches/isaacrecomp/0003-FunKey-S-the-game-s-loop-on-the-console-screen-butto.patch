--- /dev/null
+++ b/rt/funkey.cpp
@@ -0,0 +1,509 @@
+// SPDX-License-Identifier: MIT
+// FunKey S (ISAAC_FUNKEY builds): the game's loop on one thread, and what surrounds it on the console. main.cpp calls
+// funkeyEarly() first thing, funkeyPlay() in place of its threaded loop (not for --headless tests), and funkeyFinish()
+// once the save is written.
+// - The loop: buttons -> one logic tick -> (the picture: snapshot, draw, present) -> collector, 30 ticks a second on a
+//   fixed clock. When a tick and its picture take longer than 1/30 s, the next pictures are skipped (never the
+//   logic) until the clock is caught up, so the game keeps its speed; at least every 4th picture is drawn, and after
+//   a long stall (a room being built) the clock is reset rather than caught up.
+// - Screen: /dev/fb0, 240x240 RGB565 over SPI (fbtft). Only one page is backed (the driver reports more), and
+//   FBIOPAN_DISPLAY after each picture hands it over so the driver sends new pictures only (it returns an error
+//   anyway); a picture is handed over again every 0.1 s when none is new. The text console is switched to graphics
+//   with its keyboard off while the game runs.
+// - Buttons: the button daemon's virtual keyboard (the /dev/input device with KEY_A and KEY_Q).
+// - Power-off: FunKey-OS's `powerdown schedule 0.1` sends SIGUSR1 to the PID the launcher recorded and powers off 0.1 s
+//   later. A thread of its own takes the signal at once (the loop may be inside a room build): it ends the scheduled
+//   power-off, starts `powerdown handle` and shows "Shutting down..."; the loop stops, main.cpp writes the save, and
+//   funkeyFinish() runs `powerdown now`. If that hasn't happened 2.5 s after the signal (the lid cuts the power at 3 s),
+//   the thread powers off itself.
+// - Messages through the display driver's notification overlay (8x8 font, '^' starts a line).
+// The console's facts and timings come from my other FunKey S projects; this file is written for this game.
+//
+// Testing: ISAAC_FUNKEY_SCRIPT=<file> plays a headless test script (tools: "<tick> down|up <code>", "click x y",
+// "eval ...", "shot file", "quit") instead of the buttons, with the game's random numbers fixed; ISAAC_TICKMARKS=1
+// writes "OFKMEM" lines per tick and per picture (scripts/measure/tick-cost.py); ISAAC_FUNKEY_NO_POWEROFF=1 never
+// runs powerdown (a SIGUSR1 then only saves and quits).
+#ifdef ISAAC_FUNKEY
+#include "display.h"
+#include "snapshot.h"
+#include "render.h"
+#include "menuui.h"
+#include "mods.h"
+#include "core.h"
+#include <fcntl.h>
+#include <linux/fb.h>
+#include <linux/input.h>
+#include <linux/kd.h>
+#include <poll.h>
+#include <pthread.h>
+#include <signal.h>
+#include <spawn.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <termios.h>
+#include <ucontext.h>
+#include <unistd.h>
+#include <dirent.h>
+#include <algorithm>
+#include <atomic>
+#include <cerrno>
+#include <cmath>
+#include <cstdarg>
+#include <cstdio>
