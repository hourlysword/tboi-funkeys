diff --git a/CMakeLists.txt b/CMakeLists.txt
index 2271f28..1731fb7 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -8,6 +8,13 @@ add_compile_options($<$<COMPILE_LANG_AND_ID:CXX,GNU,Clang>:-ffp-contract=off> $<
 if(NOT CMAKE_BUILD_TYPE)
   set(CMAKE_BUILD_TYPE Release)
 endif()
+# FunKey S (one Cortex-A7 core, 64 MB of RAM, no GPU, a 240x240 screen; built with the tboi-funkeys toolchain): the
+# PSP's lean loading and 363x272 stage (genpsp/), one thread for the game, the PSP's memory limits, SDL2 (static,
+# for sound and timers only) and no OpenGL
+option(ISAAC_FUNKEY "FunKey S build (lean loading, PSP stage, one thread)" OFF)
+if(ISAAC_FUNKEY)
+  set(NO_SYSTEM_GL ON)
+endif()
 
 if(NINTENDO_SWITCH)
   set(SDL2_INCLUDE_DIRS ${PORTLIBS}/include/SDL2)
@@ -119,7 +126,7 @@ if(PSP)
 endif()
 
 # recompiled AVM1 code: gen/ (1440x1080 stage, PC) or gen720/ (960x720, Switch and Android: lighter on the CPU)
-if(PSP)
+if(PSP OR ISAAC_FUNKEY)
   set(ISAAC_GEN_DIR genpsp CACHE STRING "")   # 363x272 stage (_root at 56.7 %): the PSP screen's height
 elseif(NINTENDO_SWITCH OR ANDROID)
   set(ISAAC_GEN_DIR gen720 CACHE STRING "")
@@ -154,6 +161,9 @@ endif()
 # lean SWF loading (PSP; on PC for testing): the SWF is decompressed to a cache file, sounds read from it on demand,
 # shapes parsed when first drawn
 option(ISAAC_LEAN "Lean SWF loading (PSP memory budget)" OFF)
+if(ISAAC_FUNKEY)
+  set(ISAAC_LEAN ON CACHE BOOL "" FORCE)
+endif()
 if(ANDROID)
   add_library(isaac SHARED ${RT_SRC})
   set_target_properties(isaac PROPERTIES OUTPUT_NAME main)   # libmain.so: the name SDL's activity loads
@@ -191,7 +201,16 @@ if(NOT PSP)
   target_link_libraries(isaac PRIVATE isaacgen plutovg)
   if(ISAAC_LEAN)
     target_compile_definitions(isaac PRIVATE FL_LEAN)
-    target_link_libraries(isaac PRIVATE z)
+    if(ISAAC_FUNKEY)
+      find_package(ZLIB REQUIRED)   # (the static library: the FunKey toolchain only finds .a files)
+      target_link_libraries(isaac PRIVATE ZLIB::ZLIB)
+    else()
+      target_link_libraries(isaac PRIVATE z)
+    endif()
+  endif()
+  if(ISAAC_FUNKEY)
+    target_compile_definitions(isaac PRIVATE ISAAC_FUNKEY)
+    target_compile_options(isaac PRIVATE -Wno-psabi)   # (GCC's note that an ABI changed in GCC 7.1, on every call)
   endif()
 endif()
 # on Windows it can't be named isaac.exe: Steam's Isaac.exe (with the game data) usually sits in the same folder
@@ -222,6 +241,8 @@ elseif(NINTENDO_SWITCH)
     COMMAND ${DEVKITPRO}/tools/bin/nacptool --create "${APP_TITLE}" "${APP_AUTHOR}" "${APP_VERSION}" isaac.nacp
     COMMAND ${DEVKITPRO}/tools/bin/elf2nro $<TARGET_FILE:isaac> isaac.nro --icon=${CMAKE_SOURCE_DIR}/switch/icon.jpg --nacp=isaac.nacp
     COMMENT "Generating isaac.nro")
+elseif(ISAAC_FUNKEY)
+  target_link_libraries(isaac PRIVATE SDL2::SDL2-static)   # (the FunKey sysroot has SDL2 as a static library only)
 elseif(TARGET SDL2::SDL2)
   if(TARGET SDL2::SDL2main)
     target_link_libraries(isaac PRIVATE SDL2::SDL2main)
