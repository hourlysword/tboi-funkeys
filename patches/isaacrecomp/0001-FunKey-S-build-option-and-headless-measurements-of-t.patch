+// (testing) CPU time of the calling thread, ms (0 where there is no per-thread clock)
+static double threadCpuMs() {
+#if defined(CLOCK_THREAD_CPUTIME_ID) && !defined(_WIN32)
+    timespec ts; clock_gettime(CLOCK_THREAD_CPUTIME_ID, &ts); return ts.tv_sec * 1e3 + ts.tv_nsec / 1e6;
+#else
+    return 0;
+#endif
+}
 static double g_benchAlpha = 1.0;
