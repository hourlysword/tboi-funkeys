     fl::g_leanSwf = getenv("ISAAC_NOLEAN") == nullptr; fl::g_leanCacheDir = pref;   // (lean loading: PSP / tests)
+#endif
+#ifdef ISAAC_FUNKEY
+    // the PSP's memory budgets (main_psp.cpp): parsed shapes 5 MB, the least recently used dropped beyond it (only
