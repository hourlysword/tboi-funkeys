+#if !defined(__SWITCH__) && !defined(_WIN32) && !defined(__ANDROID__) && defined(__GLIBC__)
+// (diagnostics: stack sampling with SIGPROF during a specific tick, ISAAC_SAMPLE_TICK=n; glibc only: musl has no
+// backtrace())
 #include <execinfo.h>
 #include <signal.h>
 #include <sys/time.h>
@@ -320,6 +324,14 @@ static void profSampleStop() {
