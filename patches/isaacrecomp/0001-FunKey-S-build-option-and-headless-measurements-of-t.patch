 #endif
     loadConfig(base + "isaac.ini", cfg);
     {   // mods: the "mods" folder next to the program (mods.h), turned on with `mods =` in isaac.ini
@@ -838,17 +856,34 @@ int main(int argc, char** argv) {
                 if (k != aimKey) { if (aimKey) keyEvent(aimKey, 0, false); if (k) keyEvent(k, 0, true); aimKey = k; }
             }
             monkeyStep();
-            Uint64 lt0 = SDL_GetPerformanceCounter(); size_t heap0 = gcCount();
+            // (testing) "OFKMEM begin" and "OFKMEM tick" (below) bracket exactly the part of the tick that is timed: under
+            // qemu's armprof, the instructions between them are the logic's; from "tick" to the next "begin", the rest
+            // (the script's input, and mixing 1/30 s of sound: audioDumpTick)
+            static const bool tickMarks = getenv("ISAAC_TICKMARKS") != nullptr;
+            if (tickMarks) logf("OFKMEM begin %u\n", g_player.tick);
+            Uint64 lt0 = SDL_GetPerformanceCounter(); size_t heap0 = gcCount(); double cpu0 = threadCpuMs();
             static int sampleTick = getenv("ISAAC_SAMPLE_TICK") ? atoi(getenv("ISAAC_SAMPLE_TICK")) : -1;
             if ((int)g_player.tick == sampleTick) profSampleStart();
+            g_shapeTick = g_player.tick;   // (shape eviction: what was used in the last 2 s stays)
             runFrame(); runIntervals(); recompPatchesTick(); fl::modsTick();
             static const bool menuUi = getenv("ISAAC_MENUUI") != nullptr;   // (testing the controller menus / rebinding screen)
             if (menuUi) { bool ig = false, gp = recompInGameplay(&ig); menuUiTick(gp, ig); }
+            // (testing: one-core devices) without a renderer, the snapshot it would take is still built, and dropped:
+            // on a single core it is made on the logic's time, so it belongs in the tick's cost (as in main_psp.cpp)
+            static const bool snapAlways = norender && getenv("ISAAC_SNAPSHOT") != nullptr;
+            if (snapAlways) { SnapPtr s = buildSnapshot(); if (menuUi) menuUiFill(*s); }
             gcCollect();
+#ifdef ISAAC_FUNKEY
+            rasterTrim(3u << 19);   // (decoded SWF bitmaps: 1.5 MB, as on the PSP)
+#endif
             if ((int)g_player.tick == sampleTick + 1) profSampleStop();
             double lms = (SDL_GetPerformanceCounter() - lt0) * 1000.0 / freq;
             static const bool tickMs = getenv("ISAAC_TICKMS") != nullptr;   // (testing) logic cost of every tick
             if (tickMs) logf("[tick] %u %.3f %d %zu\n", g_player.tick, lms, entityCount(), gcCount());
+            // (testing) the same, one "OFKMEM" line per tick: qemu's armprof plugin (tboi-funkeys) records how many
+            // instructions ran at each such line; cpu = the time the CPU spent on this thread, which other programs
+            // running at the same time don't change
+            if (tickMarks) logf("OFKMEM tick %u ents %d ms %.3f cpu %.3f objs %zu\n", g_player.tick, entityCount(), lms, threadCpuMs() - cpu0, gcCount());
             if (stats) {
