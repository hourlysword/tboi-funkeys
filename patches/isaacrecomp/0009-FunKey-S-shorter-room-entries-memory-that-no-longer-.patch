@@ -62,6 +62,11 @@ Str* intern(std::string_view sv);
 Str* mkstr(std::string s);                  // dynamic string (not interned)
 Str* internWeak(std::string_view sv);       // interned, but freed when nothing references it (until a script uses it as a key)
 inline Str* atomOf(Str* s) { if (s->interned) { if (s->weakAtom) { s->weakAtom = 0; s->pinned = 1; } return s; } if (!s->atom) s->atom = intern(s->s); return s->atom; }
+// A clip's name given by a script (attachMovie, createEmptyMovieClip): interned weakly, as the automatic instance
+// names, so that it goes with the clip unless a script uses it as a key (which pins it). The game's sounds each make a
+// clip named "sz" and a counter: pinned, those names grew by about 25,000 an hour. Not cached in s->atom: the weak
+// atom may be freed while s lives.
+inline Str* atomOfWeak(Str* s) { if (s->interned) return s; if (s->atom) return s->atom; return internWeak(s->s); }
 
