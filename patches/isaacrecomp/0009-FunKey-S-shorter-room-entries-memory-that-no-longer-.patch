+    while (!g_sweep.empty()) sweepSome(1e9);
+}
 void gcCollect(double tickMs) {
     if (!g_sweep.empty()) {   // a few ms per tick until done
         auto s0 = std::chrono::steady_clock::now();
@@ -81,9 +88,9 @@ void gcCollect(double tickMs) {
     }
     size_t trig = (size_t)(std::max(g_lastLive, g_lim.gcMinLive) * g_lim.gcGrowth);
     bool pressure = g_gcMemPressure && g_heap.size() > g_lim.gcMinLive / 2 && g_gcMemPressure();
-    if (g_heap.size() < trig && g_extBytes < g_lim.extGcBytes && !pressure) return;
+    if (g_heap.size() < trig && g_extBytes < g_lim.extGcBytes && !pressure && !g_gcForce) return;
     // a heavy tick (room load, explosion...) postpones the mark to a lighter one, unless the heap is far over
-    if (tickMs > kGcTickTargetMs * 0.6 && g_heap.size() < trig + trig / 2 && !pressure) return;
+    if (tickMs > kGcTickTargetMs * 0.6 && g_heap.size() < trig + trig / 2 && !pressure && !g_gcForce) return;
     g_extBytes = 0;
     auto t0 = std::chrono::steady_clock::now(); size_t before = g_heap.size();
     Tracer tr;
@@ -195,6 +202,40 @@ Str* internWeak(std::string_view sv) {
     return s;
 }
 static void internForget(Str* s) { auto it = g_intern->find(std::string_view(s->s)); if (it != g_intern->end() && it->second == s) g_intern->erase(it); }
+size_t internCount() { return g_intern ? g_intern->size() : 0; }   // (diagnostics)
+// (diagnostics) the interned strings by pattern (digits as #): the commonest, "count pattern" per line
+std::string internPatterns(size_t top) {
+    std::unordered_map<std::string, size_t> pat;
+    if (g_intern) for (auto& kv : *g_intern) {
+        std::string p; bool dig = false;
+        for (char c : kv.first.substr(0, 40)) { if (c >= '0' && c <= '9') { if (!dig) p += '#'; dig = true; } else { p += c; dig = false; } }
+        pat[p + (kv.second->weakAtom ? " (weak)" : "")]++;
+    }
+    std::vector<std::pair<size_t, std::string>> v; for (auto& kv : pat) v.push_back({kv.second, kv.first});
+    std::sort(v.rbegin(), v.rend());
+    std::string out;
+    for (size_t i = 0; i < v.size() && i < top; i++) out += std::to_string(v[i].first) + " " + v[i].second + "\n";
+    return out;
+}
+// (diagnostics) what the collected heap holds: strings (all, interned) and their bytes, objects by kind, their
+// properties, arrays and their elements, scopes
+std::string gcCensus() {
+    size_t nStr = 0, strB = 0, nInt = 0, intB = 0, nObj = 0, props = 0, nArr = 0, arrEl = 0, nScope = 0, nDisp = 0, nFn = 0;
+    for (GcObj* o : g_heap) {
+        if (Str* s = dynamic_cast<Str*>(o)) { nStr++; strB += s->s.capacity(); if (s->interned) { nInt++; intB += s->s.capacity(); } continue; }
+        if (dynamic_cast<Scope*>(o)) { nScope++; continue; }
+        if (Object* ob = dynamic_cast<Object*>(o)) {
+            nObj++; props += ob->props.v.capacity();
+            if (ob->isDisplay()) nDisp++;
+            if (ob->kind == OK_FUNCTION) nFn++;
+            if (Array* a = dynamic_cast<Array*>(ob)) { nArr++; arrEl += a->el.capacity() + a->ord.capacity() / 4; }
+        }
+    }
+    char b[320];
+    snprintf(b, sizeof b, "strings %zu (%zu KB; interned %zu, %zu KB), objects %zu (display %zu, functions %zu) with %zu property slots, arrays %zu with %zu element slots, scopes %zu",
+             nStr, strB >> 10, nInt, intB >> 10, nObj, nDisp, nFn, props, nArr, arrEl, nScope);
+    return b;
+}
 static std::unordered_map<std::string, size_t>* g_strProf;
 static void strProfDump() {
     std::vector<std::pair<size_t, std::string>> v; for (auto& kv : *g_strProf) v.push_back({kv.second, kv.first});
