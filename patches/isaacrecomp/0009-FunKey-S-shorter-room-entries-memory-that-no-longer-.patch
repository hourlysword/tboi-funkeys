--- a/rt/core.cpp
+++ b/rt/core.cpp
@@ -68,6 +68,13 @@ double g_gcMs = 0;   // accumulated time spent in the collector (F3 diagnostics)
 static constexpr double kGcTickTargetMs = 12.0;
 bool (*g_gcMemPressure)() = nullptr;   // (PSP) true when memory runs low: collect now
 void gcStats(size_t* objects, size_t* lastLive, size_t* extBytes) { *objects = g_heap.size(); *lastLive = g_lastLive; *extBytes = g_extBytes; }
+static bool g_gcForce = false;
+// (diagnostics) a whole collection now, the garbage freed at once: what is left is what is alive
+void gcCollectFull() {
+    while (!g_sweep.empty()) sweepSome(1e9);
