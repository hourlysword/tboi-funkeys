+// ---------------------------------------------------------------- settings kept in isaac.ini (FunKey/isaac)
+std::string iniPath() {
+    const char* h = getenv("ISAAC_HOME"); std::string b = h && *h ? h : ".";
+    if (b.back() != '/') b += '/';
+    return b + "isaac.ini";
+}
+std::string iniGet(const std::string& key) {   // ("" when absent)
+    std::ifstream f(iniPath()); std::string line;
+    auto trim = [](const std::string& s) { size_t a = s.find_first_not_of(" \t\r"), b = s.find_last_not_of(" \t\r"); return a == std::string::npos ? std::string() : s.substr(a, b - a + 1); };
+    while (std::getline(f, line)) {
+        std::string t = trim(line); size_t eq = t.find('=');
+        if (t.empty() || t[0] == ';' || eq == std::string::npos) continue;
+        if (trim(t.substr(0, eq)) == key) return trim(t.substr(eq + 1));
+    }
+    return "";
+}
+
+// ---------------------------------------------------------------- FunKey-OS's commands: volume, brightness, amplifier
+int fkGet(const char* tool) {   // `volume get`, `brightness get`: a percentage (-1: none, e.g. on a PC)
+    std::string path = std::string("/usr/local/sbin/") + tool;
+    if (access(path.c_str(), X_OK) != 0) return -1;
+    FILE* p = popen((path + " get 2> /dev/null").c_str(), "r");
+    if (!p) return -1;
+    int v = -1; if (fscanf(p, "%d", &v) != 1) v = -1;
+    pclose(p);
+    return v;
+}
+pid_t fkSpawn(const char* tool, const char* a1, const char* a2) {   // (0: not started)
+    std::string path = std::string("/usr/local/sbin/") + tool;
+    if (access(path.c_str(), X_OK) != 0) return 0;
+    const char* argv[] = {path.c_str(), a1, a2, nullptr};
+    pid_t pid = 0;
+    return posix_spawn(&pid, path.c_str(), nullptr, nullptr, (char* const*)argv, environ) == 0 ? pid : 0;
+}
+void fkRun(const char* tool, const char* a1, const char* a2 = nullptr) { pid_t p = fkSpawn(tool, a1, a2); if (p > 0) waitpid(p, nullptr, 0); }
+// A setting changed in the menu: `volume set N` or `brightness set N`, one at a time (they write the bootloader's
+// environment, to keep the value for the next start), the last value asked for in the end
+struct FkSetting {
+    const char* tool; pid_t pid = 0; int want = -1, sent = -1;
+    void update(bool finish = false) {
+        if (pid > 0 && waitpid(pid, nullptr, finish ? 0 : WNOHANG) != 0) pid = 0;
+        if (pid == 0 && want >= 0 && want != sent) {
+            char v[16]; snprintf(v, sizeof v, "%d", want);
+            pid = fkSpawn(tool, "set", v); sent = want;
+            if (finish && pid > 0) { waitpid(pid, nullptr, 0); pid = 0; }
+        }
+    }
+};
+
+// ---------------------------------------------------------------- the menu (the Menu button)
+// In the style of FunKey-OS's own emulators' menus, as my other FunKey S projects have it: one item at a time in a light
+// grey 180x140 box with rounded corners in the middle of the screen, the game behind darkened by black at 100/255,
+// arrows above and below, dark grey text in FunKey-OS's Open Sans Bold (/usr/games/menu_resources), 22 for the item
+// and 16 for its value, the next item sliding in 30 pixels a picture at 50 pictures a second. Up and Down choose the
+// item, Left and Right change its value (held: again after 0.5 s, then every 0.1 s), A asks "Are you sure ?" for
+// EXIT GAME and A again quits (the game's save written), B takes the question back or closes the menu, Menu closes it.
+// The game, its music and the speaker's amplifier wait meanwhile. Written for this game.
+//   VOLUME and BRIGHTNESS: FunKey-OS's own (its volume and brightness commands keep them for the next start), in
+//   steps of 10, as ten bars. ASPECT RATIO: 4:3 (black bars above and below) or STRETCHED (the whole screen). SHOW
+//   FPS: the pictures drawn a second, in the top left corner. Those two are kept in isaac.ini (funkey_aspect,
+//   funkey_fps).
+// Tests: ISAAC_FUNKEY_MENU_RES, another folder for the fonts (a PC); the test script's "menushot <item> <file> [1]".
+#include "font5x7.inc"
+enum MenuItem { MI_VOLUME, MI_BRIGHTNESS, MI_ASPECT, MI_FPS, MI_EXIT, MI_COUNT };
+const char* const kMenuTitles[MI_COUNT] = {"VOLUME", "BRIGHTNESS", "ASPECT RATIO", "SHOW FPS", "EXIT GAME"};
+constexpr int MW = 240, MH = 240, BOX_W = 180, BOX_H = 140, LINE = 18;
+constexpr uint32_t kTextRgb = 0x555555u, kBoxRgb = 0xecececu;
+constexpr uint32_t kDim = 155;   // what is left of the game behind (black at 100/255 over it)
+struct MenuState {
+    plutovg_font_face_t* bold = nullptr; bool fontsTried = false;
+    std::vector<uint32_t> dim, out;
+    int item = MI_VOLUME, volume = -1, brightness = -1; bool confirm = false, fps = false;
+    FkSetting vol{"volume"}, bri{"brightness"};
+} g_menu;
+
+void menuFonts() {
+    if (g_menu.fontsTried) return;
+    g_menu.fontsTried = true;
+    const char* dir = getenv("ISAAC_FUNKEY_MENU_RES");
+    std::string d = dir && *dir ? dir : "/usr/games/menu_resources";
+    g_menu.bold = plutovg_font_face_load_from_file((d + "/OpenSans-Bold.ttf").c_str(), 0);
+    logf("[funkey] menu font: %s\n", g_menu.bold ? "Open Sans Bold" : "not found: the built-in one");
+}
+void setRgb(plutovg_canvas_t* cv, uint32_t rgb) { plutovg_canvas_set_rgb(cv, ((rgb >> 16) & 255) / 255.f, ((rgb >> 8) & 255) / 255.f, (rgb & 255) / 255.f); }
+// text across the middle of the screen, its middle `y` pixels down: Open Sans Bold at `size`, or the 5x7 dots
+void menuText(plutovg_canvas_t* cv, const char* s, float size, float y) {
+    if (g_menu.bold) {
+        plutovg_rect_t ext; float ascent = 0, descent = 0, gap = 0; plutovg_rect_t box;
+        float adv = plutovg_font_face_text_extents(g_menu.bold, size, s, -1, PLUTOVG_TEXT_ENCODING_UTF8, &ext);
+        plutovg_font_face_get_metrics(g_menu.bold, size, &ascent, &descent, &gap, &box);
+        plutovg_canvas_set_font(cv, g_menu.bold, size);
+        setRgb(cv, kTextRgb);
+        // (capitals: their middle at y; Open Sans's capitals are 0.714 of the em high)
+        plutovg_canvas_fill_text(cv, s, -1, PLUTOVG_TEXT_ENCODING_UTF8, std::floor((MW - adv) / 2), std::round(y + 0.714f * size / 2));
+        return;
+    }
+    int k = size > 18 ? 3 : 2, n = (int)strlen(s), x0 = (MW - n * 6 * k) / 2, y0 = (int)std::lround(y) - 7 * k / 2;
+    for (int i = 0; i < n; i++) {
+        const Glyph* g = nullptr; char c = (char)toupper((unsigned char)s[i]);
+        for (auto& f : kFont) if (f.c == c) g = &f;
+        if (!g) continue;
+        for (int r = 0; r < 7; r++) for (int q = 0; q < 5; q++) if (g->r[r][q] == '#')
+            for (int yy = 0; yy < k; yy++) for (int xx = 0; xx < k; xx++) {
+                int px = x0 + (i * 6 + q) * k + xx, py = y0 + r * k + yy;
+                if (px >= 0 && px < MW && py >= 0 && py < MH) g_menu.out[(size_t)py * MW + px] = 0xff000000u | kTextRgb;
+            }
+    }
+}
+void menuRect(plutovg_canvas_t* cv, float x, float y, float w, float h, uint32_t rgb) { plutovg_canvas_rect(cv, x, y, w, h); setRgb(cv, rgb); plutovg_canvas_fill(cv); }
+// ten bars across 100x20 pixels, as many filled as tenths of the percentage
+void menuBars(plutovg_canvas_t* cv, float y, int percent) {
+    const int bw = 8, gap = 2, n = 10;
+    float x0 = (MW - (n * bw + (n - 1) * gap)) / 2.f, y0 = std::round(y - 10);
+    int full = percent < 0 ? 0 : (percent + 5) / 10;
+    for (int i = 0; i < n; i++) {
+        float x = x0 + i * (bw + gap);
+        menuRect(cv, x, y0, bw, 20, kTextRgb);
+        if (i >= full) menuRect(cv, x + 1, y0 + 1, bw - 2, 18, kBoxRgb);
+    }
+}
+void menuArrows(plutovg_canvas_t* cv) {   // 20x13, halfway between the box and the screen's edges
+    float x0 = (MW - 20) / 2.f, top = (MH - BOX_H) / 4.f - 6, bottom = MH - (MH - BOX_H) / 4.f - 7;
+    plutovg_canvas_move_to(cv, x0, top + 13); plutovg_canvas_line_to(cv, x0 + 20, top + 13); plutovg_canvas_line_to(cv, x0 + 10, top); plutovg_canvas_close_path(cv);
+    plutovg_canvas_move_to(cv, x0, bottom); plutovg_canvas_line_to(cv, x0 + 20, bottom); plutovg_canvas_line_to(cv, x0 + 10, bottom + 13); plutovg_canvas_close_path(cv);
+    setRgb(cv, kBoxRgb); plutovg_canvas_fill(cv);
+}
+// an item in its box, dy pixels below its place
+void menuItem(plutovg_canvas_t* cv, int item, float dy) {
+    plutovg_canvas_round_rect(cv, (MW - BOX_W) / 2.f, (MH - BOX_H) / 2.f + dy, BOX_W, BOX_H, 5, 5);
+    setRgb(cv, kBoxRgb); plutovg_canvas_fill(cv);
+    float mid = MH / 2.f + dy;
+    char line[64];
+    switch (item) {
+        case MI_VOLUME: case MI_BRIGHTNESS:
+            menuText(cv, kMenuTitles[item], 22, mid - LINE);
+            menuBars(cv, mid + LINE, item == MI_VOLUME ? g_menu.volume : g_menu.brightness);
+            break;
+        case MI_ASPECT: case MI_FPS:
+            menuText(cv, kMenuTitles[item], 22, mid - LINE);
+            snprintf(line, sizeof line, "<   %s   >", item == MI_ASPECT ? (g_softStretch ? "STRETCHED" : "4:3") : (g_menu.fps ? "ON" : "OFF"));
+            menuText(cv, line, 16, mid + LINE);
+            break;
+        default:
+            menuText(cv, kMenuTitles[item], 22, mid);
+            if (g_menu.confirm) menuText(cv, "Are you sure ?", 16, mid + 2 * LINE);
+            break;
+    }
+}
+// the menu's picture: the darkened game, the item (or two, sliding: `slide` pixels done, dir +1 = the next one coming
+// up from below)
+void menuDraw(int prev, int slide, int dir) {
+    g_menu.out = g_menu.dim;
+    plutovg_surface_t* s = plutovg_surface_create_for_data((unsigned char*)g_menu.out.data(), MW, MH, MW * 4);
+    plutovg_canvas_t* cv = plutovg_canvas_create(s);
+    if (slide <= 0) { menuItem(cv, g_menu.item, 0); menuArrows(cv); }
+    else { menuItem(cv, prev, (float)(-dir * slide)); menuItem(cv, g_menu.item, (float)(dir * (MH - slide))); }
+    plutovg_canvas_destroy(cv); plutovg_surface_destroy(s);
+}
+void menuBackground() {   // the picture last drawn, darkened
+    int ow = 0, oh = 0; const uint32_t* last = renderSoftOutput(&ow, &oh);
+    g_menu.dim.assign((size_t)MW * MH, 0xff000000u);
+    if (!last || ow != MW || oh != MH) return;
+    for (size_t i = 0; i < g_menu.dim.size(); i++) {
+        uint32_t c = last[i];
+        g_menu.dim[i] = 0xff000000u | ((((c & 0x00ff00ffu) * kDim) >> 8) & 0x00ff00ffu) | ((((c & 0x0000ff00u) * kDim) >> 8) & 0x0000ff00u);
+    }
+}
+// (tests) the menu on one item over the last picture, into a PPM
+void menuShot(int item, bool confirm, const char* path) {
+    menuFonts(); menuBackground();
+    int keep = g_menu.item; bool keepC = g_menu.confirm;
+    g_menu.item = std::max(0, std::min(MI_COUNT - 1, item)); g_menu.confirm = confirm;
+    if (g_menu.volume < 0) g_menu.volume = 70;
+    if (g_menu.brightness < 0) g_menu.brightness = 50;
+    menuDraw(0, 0, 0);
+    if (FILE* f = fopen(path, "wb")) {
+        fprintf(f, "P6\n%d %d\n255\n", MW, MH);
+        for (uint32_t c : g_menu.out) { uint8_t px[3] = {(uint8_t)(c >> 16), (uint8_t)(c >> 8), (uint8_t)c}; fwrite(px, 1, 3, f); }
+        fclose(f);
+    }
+    g_menu.item = keep; g_menu.confirm = keepC;
+}
+// the menu until it closes; true: EXIT GAME chosen. outW/outH: the frame's size (the picture drawn again for the
+// aspect ratio)
+bool menuRun(int outW, int outH) {
+    menuFonts();
+    g_menu.confirm = false;
+    g_menu.volume = fkGet("volume"); g_menu.brightness = fkGet("brightness");
+    g_menu.vol.want = g_menu.vol.sent = g_menu.volume; g_menu.bri.want = g_menu.bri.sent = g_menu.brightness;
+    menuBackground();
+    audioSetPaused(true); fkRun("audio_amp", "off");
+    logf("[funkey] menu: open\n");
+    bool exitGame = false, open = true, dirty = true, isDown[B_COUNT] = {};
+    int held = -1, prev = g_menu.item, slide = 0, dir = 0; double repeatAt = 0;
+    auto move = [&](int d) { prev = g_menu.item; g_menu.item = (g_menu.item + d + MI_COUNT) % MI_COUNT; dir = d; slide = 30; g_menu.confirm = false; };
+    auto change = [&](int d) {
+        switch (g_menu.item) {
+            case MI_VOLUME: if (g_menu.volume >= 0) g_menu.vol.want = g_menu.volume = std::max(0, std::min(100, g_menu.volume + 10 * d)); break;
+            case MI_BRIGHTNESS: if (g_menu.brightness >= 0) g_menu.bri.want = g_menu.brightness = std::max(10, std::min(100, g_menu.brightness + 10 * d)); break;
+            case MI_ASPECT:
+                g_softStretch = !g_softStretch;
+                saveIniValue(iniPath(), "funkey_aspect", g_softStretch ? "stretched" : "4:3");
+                renderFrame(outW, outH, 1.0); renderEndFrame(); menuBackground();   // (the game behind, in its new shape)
+                break;
+            case MI_FPS: g_menu.fps = !g_menu.fps; saveIniValue(iniPath(), "funkey_fps", g_menu.fps ? "1" : "0"); break;
+            default: break;
+        }
+        dirty = true;
+    };
+    while (open && !g_stopReq && !g_powerReq) {
+        inputPoll([&](int b, bool d) {
+            isDown[b] = d;
+            if (!d) { if (b == held) held = -1; return; }
+            switch (b) {
+                case B_UP: case B_DOWN: if (!g_menu.confirm && slide == 0) { move(b == B_DOWN ? 1 : -1); held = b; repeatAt = now() + 0.5; } break;
+                case B_LEFT: case B_RIGHT: if (!g_menu.confirm) { change(b == B_RIGHT ? 1 : -1); held = b; repeatAt = now() + 0.5; } break;
+                case B_A:
+                    if (g_menu.item == MI_EXIT) { if (g_menu.confirm) { exitGame = true; open = false; } else { g_menu.confirm = true; dirty = true; } }
+                    else if (g_menu.item == MI_ASPECT || g_menu.item == MI_FPS) change(1);
+                    break;
+                case B_B: if (g_menu.confirm) { g_menu.confirm = false; dirty = true; } else open = false; break;
+                case B_MENU: open = false; break;
+                default: break;
+            }
+        });
+        if (!open) break;
+        double t = now();
+        if (held >= 0 && slide == 0 && t >= repeatAt) {
+            if (held == B_UP || held == B_DOWN) move(held == B_DOWN ? 1 : -1); else change(held == B_RIGHT ? 1 : -1);
+            repeatAt = t + 0.1;
+        }
+        g_menu.vol.update(); g_menu.bri.update();
+        if (dirty || slide > 0) {
+            menuDraw(prev, slide, dir);
+            fbPresent(g_menu.out.data(), MW, MH);
+            dirty = false;
+            if (slide > 0 && (slide += 30) >= MH) { slide = 0; dirty = true; }
+            inputWait(0.02);   // (50 pictures a second while sliding)
+        } else {
+            fbKeepShown();
+            inputWait(0.05);
+        }
+    }
+    // back to the game once the buttons are let go (1 s at most): none of them reaches it
+    for (double until = now() + 1.0; now() < until && !g_stopReq && !g_powerReq;) {
+        bool any = false; for (bool d : isDown) any |= d;
+        if (!any) break;
+        inputPoll([&](int b, bool d) { isDown[b] = d; });
+        inputWait(0.02);
+    }
+    g_menu.vol.update(true); g_menu.bri.update(true);
+    fkRun("audio_amp", "on"); audioSetPaused(false);
+    logf("[funkey] menu: %s\n", exitGame ? "EXIT GAME" : "closed");
+    return exitGame;
+}
+
